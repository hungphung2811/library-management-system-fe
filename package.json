{
  "name": "library-management-system-fe",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lms/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run build -w @lms/web && playwright test",
    "test:e2e:only": "playwright test",
    "typecheck:e2e": "tsc -p e2e"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "postcss": "^8.5.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0"
  }
}
